dist: READ FILE=colvar4.dat IGNORE_TIME VALUES=cyl.z
water: READ FILE=colvar4.dat IGNORE_TIME VALUES=L1

#uwall: READ FILE=colvar1.dat IGNORE_TIME VALUES=uwall.bias
#lwall1: READ FILE=colvar1.dat IGNORE_TIME VALUES=lwall1.bias
metad: READ FILE=colvar3.dat IGNORE_TIME VALUES=metad.rbias
weights1: REWEIGHT_METAD TEMP=300
#weights2: REWEIGHT_BIAS TEMP=300 ARG=uwall.bias

HISTOGRAM ...
ARG=dist.z,water
GRID_MIN=0.40,22.00
GRID_MAX=1.81,60.00
GRID_BIN=120,130
BANDWIDTH=0.020,0.15
LOGWEIGHTS=weights1
LABEL=hh1
... HISTOGRAM


DUMPGRID GRID=hh1 FILE=histo FMT=%24.16e
ff: CONVERT_TO_FES GRID=hh1 TEMP=300
#ff1:CONVERT_TO_FES GRID=hh2 TEMP=300
DUMPGRID GRID=ff FILE=fes_1.dat

