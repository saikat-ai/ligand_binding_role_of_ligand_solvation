dist: READ FILE=colvar1.dat IGNORE_TIME VALUES=d2
water: READ FILE=colvar1.dat IGNORE_TIME VALUES=COORD2

#uwall: READ FILE=colvar1.dat IGNORE_TIME VALUES=uwall.bias
#lwall1: READ FILE=colvar1.dat IGNORE_TIME VALUES=lwall1.bias
metad: READ FILE=colvar1.dat IGNORE_TIME VALUES=metad.rbias
weights1: REWEIGHT_METAD TEMP=300
#weights2: REWEIGHT_BIAS TEMP=300 ARG=uwall.bias

HISTOGRAM ...
ARG=dist,water
GRID_MIN=0.28,2
GRID_MAX=2.65,18
GRID_BIN=120,130
BANDWIDTH=0.035,0.25
LOGWEIGHTS=weights1
LABEL=hh1
... HISTOGRAM


DUMPGRID GRID=hh1 FILE=histo FMT=%24.16e
ff: CONVERT_TO_FES GRID=hh1 TEMP=300
#ff1:CONVERT_TO_FES GRID=hh2 TEMP=300
DUMPGRID GRID=ff FILE=fes6.dat

