WHOLEMOLECULES ENTITY0=1-2881

c2: GROUP ATOMS=1944
c1: GROUP ATOMS=1513
c3: GROUP ATOMS=1804

prot_noh: GROUP NDX_FILE=group.ndx NDX_GROUP=Protein-H
bnz: GROUP NDX_FILE=group.ndx NDX_GROUP=BNZ
# Coordination number
c: COORDINATION GROUPA=bnz GROUPB=prot_noh R_0=0.42

lig: COM ATOMS=2870,2872,2874
WATER_OXYGENS: GROUP ATOMS=2882-10774:3
COORD1: COORDINATION GROUPA=c2 GROUPB=WATER_OXYGENS SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}
COORD: COORDINATION GROUPA=c1 GROUPB=WATER_OXYGENS SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}
COORD2: COORDINATION GROUPA=lig GROUPB=WATER_OXYGENS SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}

d1: DISTANCE ATOMS=lig,1452
d2: DISTANCE ATOMS=lig,1513
d3: DISTANCE ATOMS=lig,1644
d4: DISTANCE ATOMS=lig,1704
d5: DISTANCE ATOMS=lig,1716
d6: DISTANCE ATOMS=lig,1905
d7: DISTANCE ATOMS=lig,2005
d8: DISTANCE ATOMS=lig,2094
d9: DISTANCE ATOMS=lig,2227
d10: DISTANCE ATOMS=lig,2285

helix1: COM ATOMS=1416,1428,1452,1475,1501,1513,1533,1554,1566
helix2: COM ATOMS=1964,1980,1994,2005,2028,2052,2071,2094,2111
helix3: COM ATOMS=2176,2200,2212,2227,2239,2251,2271,2285,2308
helix4: COM ATOMS=2535,2559,2583,2603,2626,2642,2658,2678,2702

hd12: DISTANCE ATOMS=helix1,helix2
hd23: DISTANCE ATOMS=helix2,helix3
hd34: DISTANCE ATOMS=helix3,helix4
rmsd: RMSD REFERENCE=LigRMSDRef.pdb TYPE=OPTIMAL

#SCALED_d1: MATHEVAL ARG=d1 FUNC=(x-0.426)/(4.30-0.426) PERIODIC=NO
SCALED_d2: MATHEVAL ARG=d2 FUNC=(x-0.485)/(4.547-0.485) PERIODIC=NO
#SCALED_d3: MATHEVAL ARG=d3 FUNC=(x-0.536)/(4.93-0.536) PERIODIC=NO
#SCALED_d5: MATHEVAL ARG=d5 FUNC=(x-0.369)/(4.68-0.33068) PERIODIC=NO
#SCALED_d8: MATHEVAL ARG=d8 FUNC=(x-0.505)/(5.338-0.505) PERIODIC=NO
SCALED_COOR: MATHEVAL ARG=COORD2 FUNC=(x-2.409)/(18.434-2.409) PERIODIC=NO
#rmsd1: MATHEVAL ARG=rmsd FUNC=(x-0.0196)/(7.890-0.0196) PERIODIC=NO
#SCALED_COOR1: MATHEVAL ARG=COORD1 FUNC=(x-3.239)/(7.036-3.239) PERIODIC=NO

#COMBINE LABEL=lt0 ARG=SCALED_d1,SCALED_d2,SCALED_d3,SCALED_d5,SCALED_COOR COEFFICIENTS=4.567115,6.210364,-4.961456,-1.003391,-0.855789 PERIODIC=NO
COMBINE LABEL=lt0 ARG=SCALED_d2,SCALED_COOR COEFFICIENTS=0.16914982,1.13434257 PERIODIC=NO
COMBINE LABEL=lt1 ARG=SCALED_d2,SCALED_COOR COEFFICIENTS=10.10851696,-7.90497658 PERIODIC=NO

metad: METAD ARG=lt0,lt1 SIGMA=0.04,0.20 HEIGHT=1.55 PACE=500 BIASFACTOR=60.0 TEMP=300 GRID_MIN=-0.20,-2.40 GRID_MAX=1.60,5.30 CALC_RCT RCT_USTRIDE=20
#opes: OPES_METAD ARG=lt1,lt2 SIGMA=0.35,0.0025 PACE=500 TEMP=300 BARRIER=65.0

uwall1: UPPER_WALLS ARG=d2 AT=2.30 KAPPA=20000 EXP=4 EPS=1.0
lwall1: LOWER_WALLS ARG=d2 AT=0.38 KAPPA=13000 EXP=4 EPS=1.0
LOWER_WALLS AT=0.04 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=topwall
# Wall on distance to prevent the ligand entering the intracellular part
UPPER_WALLS AT=1.31 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=bottomwall
LOWER_WALLS AT=-2.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=topwall1
UPPER_WALLS AT=5.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=bottomwall1

PRINT ARG=d1,d2,d3,d4,d5,d6,d7,d8,d9,d10,rmsd,lt0,hd12,hd23,hd34,COORD1,COORD,COORD2,lt1,metad.rbias STRIDE=500 FILE=colvar1.dat
