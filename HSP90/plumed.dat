RESTART

#################################################
### DEFINE RADIUS + CALC PROT-LIG VECTOR COMP ###
#################################################
MOLINFO STRUCTURE=whole.pdb
protein: GROUP ATOMS=19-3285
ligand: GROUP ATOMS=1-18
WHOLEMOLECULES STRIDE=1 ENTITY0=protein ENTITY1=ligand
WRAPAROUND ATOMS=ligand AROUND=2615 GROUPBY=18 #random CA close to the binding pocket VAL171

##########################
### DEFINITION_OF_COMs ###
##########################
lig: COM ATOMS=ligand
p0: COM ATOMS=1039,1058,1213,1227,2593,2631,2059,2615,2631
p1: COM ATOMS=542,561,580,591,605,616,1384,1396,1894,2089,2124,2579,2593,2615

p3: COM ATOMS=19-3285
d3: DISTANCE ATOMS=p3,lig
WO: GROUP ATOMS=3286-43633:3

# Protein atoms to solvate
P1: GROUP ATOMS=598  #ND2 ASN    36
P2: GROUP ATOMS=1269  #OD2 ASP    78 
P3: GROUP ATOMS=1391  #OD2 ASP    87
P4: GROUP ATOMS=2587  #OG1 THR   169

NP1: COORDINATION GROUPA=P1  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.48 NN=6 MM=10}
NP2: COORDINATION GROUPA=P2  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.48 NN=6 MM=10}
NP3: COORDINATION GROUPA=P3  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.48 NN=6 MM=10}
NP4: COORDINATION GROUPA=P4  GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.48 NN=6 MM=10}

# Ligand atoms to solvate
G1: GROUP ATOMS=1  #N1  MOL   210
G2: GROUP ATOMS=9  #S1  MOL   210

NG1: COORDINATION GROUPA=G1 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.48 NN=6 MM=10}
NG2: COORDINATION GROUPA=G2 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.48 NN=6 MM=10}

##############################
pp: PROJECTION_ON_AXIS AXIS_ATOMS=p0,p1 ATOM=lig

################
#RMSD WALLS ####
################
rmsd_protCA: RMSD REFERENCE=../prot_rmsd.pdb TYPE=OPTIMAL
uwall_rmsd_protCA: UPPER_WALLS ARG=rmsd_protCA AT=0.25 KAPPA=200000

##########################
### CMAP #################
##########################
INCLUDE FILE=cmap.dat

##########################
# Stiff lig torsions #####
##########################
lig_torsion1: TORSION ATOMS=3,1,2,5
lig_torsion2: TORSION ATOMS=1,2,5,9

#########################
### FUNNEL_PARAMETERS ###
#########################
s_cent: CONSTANT VALUES=2.0                                    # INFLEXION
beta_cent: CONSTANT VALUES=0.5                                 # STEEPNESS
wall_width: CONSTANT VALUES=0.1                                # WIDTH (h)
wall_buffer: CONSTANT VALUES=0.25                              # BUFFER (f, total width = WIDTH + BUFFER)
lwall: LOWER_WALLS ARG=pp.proj AT=1.0 KAPPA=20000.0            # Lower Wall (the starting point of the funnel)
uwall: UPPER_WALLS ARG=pp.proj AT=3.7 KAPPA=20000.0            # Upper Wall (the ending point of the funnel)

####################################
########### CALCULATE FUNNEL #######
# Returns the radius of the funnel
# at the current value of the cv
####################################
MATHEVAL ...
    LABEL=wall_center
    ARG=pp.proj,s_cent,beta_cent,wall_width,wall_buffer
    VAR=s,sc,b,h,f
    FUNC=h*(1./(1.+exp(b*(s-sc))))+f
    PERIODIC=NO
... MATHEVAL

################################
##### POTENTIAL_PARAMETERS #####
################################
scaling: CONSTANT VALUES=1.0
spring: CONSTANT VALUES=10000.0

################################
####### DEFINE_POTENTIAL #######
################################
MATHEVAL ...
    LABEL=wall_bias
    ARG=pp.ext,spring,wall_center,scaling
    VAR=z,k,zc,sf
    FUNC=step(z-zc)*k*(z-zc)*(z-zc)/(sf*sf)
    PERIODIC=NO
... MATHEVAL
finalbias: BIASVALUE ARG=wall_bias

SCALED_d1: MATHEVAL ARG=pp.proj FUNC=(x-1.0807)/(3.7438-1.0807) PERIODIC=NO
SCALED_COOR: MATHEVAL ARG=NG2 FUNC=(x-11.0103)/(46.4716-11.0103) PERIODIC=NO

COMBINE LABEL=lt0 ARG=SCALED_d1,SCALED_COOR COEFFICIENTS=0.16914982,1.13434257 PERIODIC=NO
COMBINE LABEL=lt1 ARG=SCALED_d1,SCALED_COOR COEFFICIENTS=10.10851696,-7.90497658 PERIODIC=NO

metad: METAD ARG=lt0,lt1 SIGMA=0.04,0.13 HEIGHT=1.50 PACE=500 BIASFACTOR=30.0 GRID_MIN=-0.50,-2.60 GRID_MAX=2.40,5.80 CALC_RCT

LOWER_WALLS AT=0.04 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=lwall1
UPPER_WALLS AT=1.31 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=uwall1
LOWER_WALLS AT=-2.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=lwall2
UPPER_WALLS AT=5.00 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=uwall2
#LOWER_WALLS AT=0.35 ARG=d3 KAPPA=20000.0 EXP=2 LABEL=lwall3
#UPPER_WALLS AT=3.03 ARG=d3 KAPPA=20000.0 EXP=2 LABEL=uwall3

PRINT ARG=pp.proj,d3,NG2,NP1,NP2,cmap,lt0,lt1,metad.rbias,wall_bias STRIDE=500 FILE=colvar3.dat FMT=%8.4f

