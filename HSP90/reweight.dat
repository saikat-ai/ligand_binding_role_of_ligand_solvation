dist: READ FILE=colvar3.dat IGNORE_TIME VALUES=pp.proj
#water: READ FILE=colvar3.dat IGNORE_TIME VALUES=NG2

#uwall: READ FILE=colvar1.dat IGNORE_TIME VALUES=uwall.bias
#lwall1: READ FILE=colvar1.dat IGNORE_TIME VALUES=lwall1.bias
metad: READ FILE=colvar3.dat IGNORE_TIME VALUES=metad.rbias
weights1: REWEIGHT_METAD TEMP=300 ARG=metad.rbias
#weights2: REWEIGHT_METAD TEMP=300 ARG=metad1.rbias

HISTOGRAM ...
ARG=dist.proj
GRID_MIN=0.97
GRID_MAX=3.80
GRID_BIN=130
BANDWIDTH=0.035
LOGWEIGHTS=weights1
LABEL=hh1
... HISTOGRAM


DUMPGRID GRID=hh1 FILE=histo FMT=%24.16e
ff: CONVERT_TO_FES GRID=hh1 TEMP=300
#ff1:CONVERT_TO_FES GRID=hh2 TEMP=300
DUMPGRID GRID=ff FILE=fes-rew_ STRIDE=10000

