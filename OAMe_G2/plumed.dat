# --- (1) ATOMS DEFINITIONS and ALIGNMENT ---

HOST: GROUP ATOMS=16-211      #host atoms
LIGC: GROUP ATOMS=1-7,9  #carbon atoms in the ligand
l1: GROUP ATOMS=1             #ligand selected atoms
l2: GROUP ATOMS=4
l3: GROUP ATOMS=8
l4: GROUP ATOMS=9
WO: GROUP ATOMS=221-6520:3    #water oxygen atoms

WHOLEMOLECULES ENTITY0=HOST
FIT_TO_TEMPLATE STRIDE=1 REFERENCE=conf_template.pdb TYPE=OPTIMAL #coordinates alignment
lig: CENTER ATOMS=LIGC

v1: FIXEDATOM AT=2.0136,2.0136,2.0   #virtual atoms
v2: FIXEDATOM AT=2.0136,2.0136,2.25
v3: FIXEDATOM AT=2.0136,2.0136,2.5
v5: FIXEDATOM AT=2.0136,2.0136,3.0

cyl: DISTANCE ATOMS=v1,lig COMPONENTS
radius: MATHEVAL ARG=cyl.x,cyl.y FUNC=sqrt(x*x+y*y) PERIODIC=NO

# --- (2) DESCRIPTORS ---
L1: COORDINATION GROUPA=l1 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
L2: COORDINATION GROUPA=l2 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
L3: COORDINATION GROUPA=l3 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
L4: COORDINATION GROUPA=l4 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
V1: COORDINATION GROUPA=v1 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
V2: COORDINATION GROUPA=v2 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
V3: COORDINATION GROUPA=v3 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}
V5: COORDINATION GROUPA=v5 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.52 NN=6 MM=10}

funnel: MATHEVAL ARG=radius,cyl.z VAR=r,z FUNC=(r+1.0*(-1.2+z))*step(-z+1.)+(r-0.2)*step(z-1.) PERIODIC=NO
UPPER_WALLS AT=0 ARG=funnel KAPPA=2000.0 LABEL=funnelwall  #funnel restraint
UPPER_WALLS AT=1.79 ARG=cyl.z KAPPA=15000.0 EXP=2 LABEL=upwall  #upper limit of cyl.z

ang: ANGLE ATOMS=v3,v5,8,6   #angle of a ligand's axis with z
cosang: MATHEVAL ARG=ang FUNC=cos(x) PERIODIC=NO

SCALED_d1: MATHEVAL ARG=cyl.z FUNC=(x-0.258)/(1.880-0.258) PERIODIC=NO
SCALED_COORD: MATHEVAL ARG=L2 FUNC=(x-25.83)/(54.20-25.83) PERIODIC=NO
SCALED_COORD2: MATHEVAL ARG=V2 FUNC=(x-24.20)/(34.60-24.20)  PERIODIC=NO

COMBINE LABEL=lt0 ARG=SCALED_d1,SCALED_COORD COEFFICIENTS=0.16914982,1.13434257   PERIODIC=NO
COMBINE LABEL=lt1 ARG=SCALED_d1,SCALED_COORD COEFFICIENTS=10.10851696,-7.90497658 PERIODIC=NO

metad: METAD ARG=lt0 SIGMA=0.04 HEIGHT=1.50 PACE=500 BIASFACTOR=30.0 TEMP=300 GRID_MIN=-0.2 GRID_MAX=1.60 CALC_RCT
LOWER_WALLS AT=0.30 ARG=cyl.z KAPPA=15000.0 EXP=2 LABEL=lwall
LOWER_WALLS AT=0.06 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=topwall
# Wall on distance to prevent the ligand entering the intracellular part
UPPER_WALLS AT=1.31 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=bottomwall
#LOWER_WALLS AT=-2.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=topwall1
#UPPER_WALLS AT=5.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=bottomwall1
#
PRINT ARG=lt0,cyl.z,L1,L2,L3,L4,V1,V2,V3,V5,lt1,ang,metad.bias,metad.rbias,lwall.bias STRIDE=500 FILE=colvar3.dat FMT=%8.4f
