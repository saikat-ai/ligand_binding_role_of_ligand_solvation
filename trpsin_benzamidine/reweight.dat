dist: READ FILE=colvar1.dat IGNORE_TIME VALUES=cyl.z
water: READ FILE=colvar1.dat IGNORE_TIME VALUES=NG
metad: READ FILE=colvar1.dat IGNORE_TIME VALUES=metad.rbias
weights1: REWEIGHT_METAD TEMP=300
#weights2: REWEIGHT_BIAS TEMP=300 ARG=uwall.bias

HISTOGRAM ...
ARG=dist.z,water
GRID_MIN=0.15,15
GRID_MAX=2.85,56.5
GRID_BIN=120,140
BANDWIDTH=0.040,0.40
LOGWEIGHTS=weights1
LABEL=hh1
... HISTOGRAM


DUMPGRID GRID=hh1 FILE=histo FMT=%24.16e
ff: CONVERT_TO_FES GRID=hh1 TEMP=300
#ff1:CONVERT_TO_FES GRID=hh2 TEMP=300
DUMPGRID GRID=ff FILE=fes_4.dat

