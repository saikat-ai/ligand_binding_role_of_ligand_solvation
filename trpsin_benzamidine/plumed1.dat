# --- (1) ATOMS DEFINITIONS and ALIGNMENT ---
#RESTART
protein: GROUP ATOMS=1-3232
WHOLEMOLECULES ENTITY0=protein
FIT_TO_TEMPLATE STRIDE=1 REFERENCE=fit_tem.pdb TYPE=OPTIMAL

WO: GROUP ATOMS=3251-47362:3 # water molecules

G: GROUP ATOMS=3236  #ligand selected atom
H: GROUP ATOMS=2480   #Bindong pose selected atom
c2: CENTER ATOMS=3236,3240,3241,3243,3245,3247,3249
c3: CENTER ATOMS=3233-3250

# virtual atoms
v14:     FIXEDATOM AT=4.070,3.450,3.834
v15:    FIXEDATOM AT=3.887,3.241,3.875

lig: CENTER ATOMS=3233,3236,3237,3240,3241,3243,3245,3247,3249  #Carbon and Nitrogen atoms of the ligand

NG: COORDINATION GROUPA=G GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}
NH: COORDINATION GROUPA=H GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}
N1: COORDINATION GROUPA=c2 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}
N2: COORDINATION GROUPA=c3 GROUPB=WO SWITCH={RATIONAL D_0=0.0 R_0=0.50 NN=6 MM=10}
d1: DISTANCE ATOMS=2475,2756
d2: DISTANCE ATOMS=c2,2480

# ---(3) Funnel ---
cyl: DISTANCE ATOMS=v14,lig COMPONENTS
radius: MATHEVAL ARG=cyl.x,cyl.y VAR=x,y FUNC=sqrt(x*x+y*y) PERIODIC=NO
funnel: MATHEVAL ARG=radius,cyl.z VAR=r,z FUNC=(r+0.5*(-1.6+z))*step(-z+1.2)+(r-0.2)*step(z-1.2) PERIODIC=NO
UPPER_WALLS AT=0 ARG=funnel KAPPA=10000.0 LABEL=funnelwall

SCALED_d1: MATHEVAL ARG=cyl.z FUNC=(x-0.049)/(2.90-0.049) PERIODIC=NO
SCALED_COORD: MATHEVAL ARG=NG FUNC=(x-16.921)/(54.50-16.921) PERIODIC=NO
SCALED_COORD2: MATHEVAL ARG=NH FUNC=(x-17.36)/(27.10-17.36)  PERIODIC=NO

COMBINE LABEL=lt0 ARG=SCALED_d1,SCALED_COORD COEFFICIENTS=0.16914982,1.13434257   PERIODIC=NO
COMBINE LABEL=lt1 ARG=SCALED_d1,SCALED_COORD COEFFICIENTS=10.10851696,-7.90497658 PERIODIC=NO
#COMBINE LABEL=lt1 ARG=SCALED_d1,SCALED_COORD,SCALED_COORD2 COEFFICIENTS=3.60141575,3.68663466,0.14995022 PERIODIC=NO
#########DEFINE_METAD###########
#metad: METAD ARG=lt0,lt1 SIGMA=0.04,0.22 HEIGHT=1.6 PACE=200 BIASFACTOR=65.0 TEMP=300 GRID_MIN=-0.20,-2.35 GRID_MAX=1.60,5.30
LOWER_WALLS AT=0.06 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=topwall
## Wall on distance to prevent the ligand entering the intracellular part
UPPER_WALLS AT=1.31 ARG=lt0 KAPPA=15000.0 EXP=2 LABEL=bottomwall
LOWER_WALLS AT=-2.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=topwall1
UPPER_WALLS AT=5.05 ARG=lt1 KAPPA=20000.0 EXP=2 LABEL=bottomwall1
LOWER_WALLS AT=0.21 ARG=cyl.z KAPPA=15000.0 EXP=2 LABEL=lwall
UPPER_WALLS AT=2.77 ARG=cyl.z KAPPA=15000.0 EXP=2 LABEL=uwall

#
# ---(5) This rmsd restricts the CA momevement of the entire protein
rmsdINIT: RMSD REFERENCE=fit_tem.pdb TYPE=OPTIMAL
UPPER_WALLS ARG=rmsdINIT AT=0.09 KAPPA=420000 EXP=2 OFFSET=0 LABEL=rmsdwallINIT 

metad: METAD ARG=lt0,lt1 SIGMA=0.04,0.22 HEIGHT=1.53 PACE=500 BIASFACTOR=50.0 TEMP=300 GRID_MIN=-0.20,-2.35 GRID_MAX=1.60,5.30 CALC_RCT STRIDE=3 RCT_USTRIDE=5
PRINT ARG=lt0,cyl.z,d2,NG,NH,d1,lt1,metad.bias,metad.rbias,lwall.bias,uwall.bias STRIDE=500 FILE=colvar1.dat FMT=%8.4f



